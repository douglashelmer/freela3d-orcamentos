generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String        @id @default(cuid())
  email                  String        @unique
  password               String
  name                   String
  company                String?
  phone                  String?
  logo                   String?
  specialty              String?
  address                String?
  neighborhood           String?
  city                   String?
  state                  String?
  zipCode                String?
  monthlyGoal            Float?
  onboardingCompleted    Boolean       @default(false)
  googleAccessToken      String?
  googleRefreshToken     String?
  googleTokenExpiry      DateTime?
  googleCalendarConnected Boolean      @default(false)
  notificationPrefs      String?
  metaPixelId            String?
  pdfSettings            String?
  document               String?
  createdAt              DateTime      @default(now())
  quotes                 Quote[]
  services               Service[]
  leads                  Lead[]
  transactions           Transaction[]
  tasks                  Task[]
  appointments           Appointment[]
  briefings              Briefing[]
  contractTemplates      ContractTemplate[]
  contracts              Contract[]
}

model ContractTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId           String?
  clientName           String
  clientDocument       String?
  clientRepresentative String?
  clientEmail          String?
  clientPhone          String?
  clientAddress        String?
  clientAddressNumber  String?
  clientNeighborhood   String?
  clientCity           String?
  clientState          String?
  projectName          String
  services             String?
  duration             String   @default("90 dias a partir da assinatura")
  totalValue           Float    @default(0)
  discount             Float    @default(0)
  finalValue           Float    @default(0)
  installments         Int      @default(1)
  paymentMethod        String   @default("PIX")
  paymentConditions    String   @default("À vista")
  generatedContent     String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Appointment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  location      String?
  startAt       DateTime
  endAt         DateTime?
  allDay        Boolean   @default(false)
  color         String?   @default("#60a5fa")
  googleEventId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String
  price       Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Client {
  id           String    @id @default(cuid())
  userId       String?
  name         String
  email        String?
  phone        String?
  document     String?
  company      String?
  address      String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?
  tags         String?
  notes        String?
  birthDate    DateTime?
  createdAt    DateTime  @default(now())
  quotes       Quote[]
}

model Lead {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  document       String?
  zipCode        String?
  address        String?
  neighborhood   String?
  city           String?
  state          String?
  project        String?
  estimatedValue Float?
  birthDate      DateTime?
  tags           String?
  notes          String?
  column         String    @default("NEW")
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Transaction {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  description String
  amount      Float
  dueDate     DateTime
  paidAt      DateTime?
  status      String    @default("PENDING")
  category    String?
  notes       String?
  createdAt   DateTime  @default(now())
}

model Briefing {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String    @unique
  type        String    @default("OTHER")
  clientName  String
  clientEmail String
  quoteId     String?
  status      String    @default("PENDING")
  projectType String?
  description String?
  references  String?
  deadline    String?
  budget      String?
  answeredAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  column      String    @default("TODO")
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  tags        String?
  imageUrl    String?
  links       String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Quote {
  id            String      @id @default(cuid())
  token         String      @unique
  number        String
  title         String
  status        QuoteStatus @default(DRAFT)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  clientId      String?
  client        Client?     @relation(fields: [clientId], references: [id])
  sections      Section[]
  items         QuoteItem[]
  discount      Float       @default(0)
  discountType  String      @default("percent")
  notes         String?
  contractTerms String?
  observations  String?
  paymentMethods String?
  validUntil    DateTime?
  signedAt      DateTime?
  signatureData String?
  signedByName  String?
  signedByDoc   String?
  viewedAt      DateTime?
  sentAt        DateTime?
  payment       Payment?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  DECLINED
  PAID
}

model Section {
  id      String         @id @default(cuid())
  quoteId String
  quote   Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type    SectionType
  title   String?
  content String?
  order   Int
  images  SectionImage[]
}

enum SectionType {
  TEXT
  IMAGES
  TERMS
}

model QuoteItem {
  id           String   @id @default(cuid())
  quoteId      String
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  type         ItemType @default(SERVICE)
  quantity     Float    @default(1)
  unit         String?
  price        Float
  discount     Float    @default(0)
  discountType String   @default("percent")
  order        Int
}

enum ItemType {
  SERVICE
  PACKAGE
  DAILY
  UNIQUE
  PRODUCT
}

model SectionImage {
  id        String  @id @default(cuid())
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  url       String
  name      String?
  order     Int
}

model Payment {
  id        String        @id @default(cuid())
  quoteId   String        @unique
  quote     Quote         @relation(fields: [quoteId], references: [id])
  asaasId   String?
  status    PaymentStatus @default(PENDING)
  method    String?
  amount    Float
  dueDate   DateTime?
  paidAt    DateTime?
  pixCode   String?
  pixQrCode String?
  boletoUrl String?
  createdAt DateTime      @default(now())
}

enum PaymentStatus {
  PENDING
  RECEIVED
  CONFIRMED
  OVERDUE
  CANCELLED
}

model ReminderSent {
  id          String   @id @default(cuid())
  appointmentId String
  type        String   // "30min" | "10min"
  sentAt      DateTime @default(now())

  @@unique([appointmentId, type])
}
